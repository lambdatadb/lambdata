{
  "name": "kilndb",
  "version": "0.1.0",
  "description": "Self-hosted MySQL and MariaDB control plane with a web console, Data API, Auth, Realtime, Functions, and Storage.",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.1.0"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/api start",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "puppeteer-core": "^25.0.2",
    "typescript": "^5.6.3"
  }
}
